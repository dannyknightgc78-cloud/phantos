# Cloudit GPU backend (default) — ComfyUI first, Phantom SSH fallback
EXECUTION_BACKEND=cloudit
CLOUDIT_VIDEO_URL=https://video.cloudsit.app
CLOUDIT_COMFY_URL=https://comfy.cloudsit.app
CLOUDIT_AI_URL=https://ai.dannygc.cloud/v1
CLOUDIT_GPU_SSH=temp-gpu
CLOUDIT_FALLBACK_PHANTOM=true

# Remote Phantom on Cloudit GPU (when ComfyUI is down)
REMOTE_PHANTOM_ROOT=/data/Phantom
REMOTE_WAN_CKPT_DIR=/data/Phantom/Wan2.1-T2V-1.3B
REMOTE_PHANTOM_CKPT=/data/Phantom/Phantom-Wan-Models/Phantom-Wan-1.3B.pth
REMOTE_WORK_DIR=/data/phantos-jobs

HOST=0.0.0.0
PORT=8787
DEFAULT_MODEL=phantom-wan-14b
